<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch screen theme -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Normal Flutter activity theme -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- 🔥 ADD THIS NEW THEME FOR UCropActivity (SAFE, NO OVERLAP) -->
    <style name="UCropSafeTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Prevent edge-to-edge clipping -->
        <item name="android:fitsSystemWindows">true</item>

        <!-- Prevent full-screen extension -->
        <item name="android:windowFullscreen">false</item>

        <!-- Ensure toolbar + status bar visible -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>

